{
  "$schema": "https://raw.githubusercontent.com/InkSha/sumi/refs/heads/master/schema/v1/plugin.schema.json",
  "name": "sumi-plugin-rand",
  "version": "1.1.0",
  "description": "Random value",
  "author": "InkSha",
  "license": "MIT",
  "repo": "https://github.com/summink/sumi-plugin-rand",
  "doc": "https://github.com/summink/sumi-plugin-rand",
  "platforms": [
    {
      "os": "windows",
      "arch": "amd64"
    },
    {
      "os": "windows",
      "arch": "x86"
    },
    {
      "os": "linux",
      "arch": "amd64"
    },
    {
      "os": "macos",
      "arch": "amd64"
    }
  ],
  "tags": [
    "plugin",
    "random",
    "int",
    "float",
    "string"
  ],
  "args": [],
  "flags": [
    {
      "name": "int",
      "type": "bool",
      "description": "set random int",
      "required": false
    },
    {
      "name": "float",
      "type": "bool",
      "description": "set random float",
      "required": false
    },
    {
      "name": "string",
      "type": "bool",
      "description": "set random string",
      "required": false,
      "value": "true"
    },
    {
      "name": "range",
      "type": "string[]",
      "description": "set random charsets",
      "required": false
    },
    {
      "name": "copy",
      "type": "bool",
      "description": "copy random value to clipboard",
      "required": false
    },
    {
      "name": "max",
      "type": "int",
      "description": "max number or max string length",
      "required": false,
      "value": "10000"
    },
    {
      "name": "min",
      "type": "int",
      "description": "min number or min string length",
      "required": false,
      "value": "1"
    }
  ]
}
